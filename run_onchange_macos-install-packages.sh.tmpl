{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash

set -e

# Ensure Homebrew is installed
if ! command -v brew >/dev/null 2>&1; then
    echo "Installing Homebrew..."
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

{{- $machine := index .machines .chezmoi.hostname | default dict -}}
{{- $packages := concat .packages.brew (get $machine "brew" | default list) -}}

{{- if not (hasKey .machines .chezmoi.hostname) }}
echo "No machine entry for {{ .chezmoi.hostname }} in .chezmoidata/machines.yaml; installing common packages only."
{{- end }}

{{- if $packages }}
# Compare the manifest with installed formulae before installing.
declared_packages=(
{{ range $packages }}
  {{ printf "%q" . }}
{{ end }})

declared_list=$(printf '%s\n' "${declared_packages[@]}" | sort -u)
installed_list=$(brew list --formula -1 | sort -u)
requested_list=$(brew leaves --installed-on-request | sort -u)
missing=$(comm -23 <(printf '%s\n' "$declared_list") <(printf '%s\n' "$installed_list"))
extra=$(comm -13 <(printf '%s\n' "$declared_list") <(printf '%s\n' "$requested_list"))

if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
    extra_color=$'\033[1;33m'
    color_reset=$'\033[0m'
else
    extra_color=''
    color_reset=''
fi

echo 'Running package synchronization...'

if [[ -n "$extra" ]]; then
    printf '%b%s%b\n' "$extra_color" 'The following packages are installed but not in the packages.yml' "$color_reset"
    printf '%s\n' "$extra" | sed 's/^/  /'
fi

if [[ -n "$missing" ]]; then
    # macOS ships bash 3.2, which has no mapfile.
    packages_to_install=()
    while IFS= read -r package; do
        packages_to_install+=("$package")
    done <<< "$missing"
    printf 'Installing missing brew packages: %s\n' "${packages_to_install[*]}"
    brew install "${packages_to_install[@]}"
fi
{{- end }}

# Change shell to fish if installed
if command -v fish >/dev/null 2>&1; then
    FISH_PATH=$(command -v fish)
    if [ "$SHELL" != "$FISH_PATH" ]; then
        if ! grep -q "^$FISH_PATH$" /etc/shells; then
            echo "Adding fish to /etc/shells"
            echo "$FISH_PATH" | sudo tee -a /etc/shells
        fi
        echo "Changing shell to fish"
        chsh -s "$FISH_PATH"
    fi
fi

echo 'Finished package synchronization.'

{{ end -}}
