{{- /* Renders one entry of .terminal.themes as an OpenCode theme file. */ -}}
{{- $t := . -}}
{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "background": {{ $t.background | quote }},
    "foreground": {{ $t.foreground | quote }},
    "black": {{ $t.black | quote }},
    "red": {{ $t.red | quote }},
    "green": {{ $t.green | quote }},
    "yellow": {{ $t.yellow | quote }},
    "blue": {{ $t.blue | quote }},
    "purple": {{ $t.purple | quote }},
    "cyan": {{ $t.cyan | quote }},
    "white": {{ $t.white | quote }},
    "brightBlack": {{ $t.brightBlack | quote }},
    "brightRed": {{ $t.brightRed | quote }},
    "brightGreen": {{ $t.brightGreen | quote }},
    "brightYellow": {{ $t.brightYellow | quote }},
    "brightBlue": {{ $t.brightBlue | quote }},
    "brightPurple": {{ $t.brightPurple | quote }},
    "brightCyan": {{ $t.brightCyan | quote }},
    "brightWhite": {{ $t.brightWhite | quote }}
  },
  "theme": {
    "primary": { "dark": "blue", "light": "blue" },
    "secondary": { "dark": "purple", "light": "purple" },
    "accent": { "dark": "brightGreen", "light": "brightGreen" },
    "error": { "dark": "red", "light": "red" },
    "warning": { "dark": "yellow", "light": "yellow" },
    "success": { "dark": "green", "light": "green" },
    "info": { "dark": "cyan", "light": "cyan" },
    "text": { "dark": "foreground", "light": "foreground" },
    "textMuted": { "dark": "cyan", "light": "cyan" },
    "background": { "dark": "background", "light": "background" },
    "backgroundPanel": { "dark": "background", "light": "background" },
    "backgroundElement": { "dark": "background", "light": "background" },
    "border": { "dark": "brightBlack", "light": "brightBlack" },
    "borderActive": { "dark": "brightBlue", "light": "brightBlue" },
    "borderSubtle": { "dark": "brightBlack", "light": "brightBlack" },
    "diffAdded": { "dark": "green", "light": "green" },
    "diffRemoved": { "dark": "red", "light": "red" },
    "diffContext": { "dark": "cyan", "light": "cyan" },
    "diffHunkHeader": { "dark": "brightCyan", "light": "brightCyan" },
    "diffHighlightAdded": { "dark": "brightGreen", "light": "brightGreen" },
    "diffHighlightRemoved": { "dark": "brightRed", "light": "brightRed" },
    "diffAddedBg": { "dark": "background", "light": "background" },
    "diffRemovedBg": { "dark": "background", "light": "background" },
    "diffContextBg": { "dark": "background", "light": "background" },
    "diffLineNumber": { "dark": "brightBlack", "light": "brightBlack" },
    "diffAddedLineNumberBg": { "dark": "background", "light": "background" },
    "diffRemovedLineNumberBg": { "dark": "background", "light": "background" },
    "markdownText": { "dark": "foreground", "light": "foreground" },
    "markdownHeading": { "dark": "brightPurple", "light": "brightPurple" },
    "markdownLink": { "dark": "brightBlue", "light": "brightBlue" },
    "markdownLinkText": { "dark": "brightCyan", "light": "brightCyan" },
    "markdownCode": { "dark": "brightGreen", "light": "brightGreen" },
    "markdownBlockQuote": { "dark": "cyan", "light": "cyan" },
    "markdownEmph": { "dark": "brightYellow", "light": "brightYellow" },
    "markdownStrong": { "dark": "brightRed", "light": "brightRed" },
    "markdownHorizontalRule": { "dark": "brightBlack", "light": "brightBlack" },
    "markdownListItem": { "dark": "blue", "light": "blue" },
    "markdownListEnumeration": { "dark": "cyan", "light": "cyan" },
    "markdownImage": { "dark": "brightBlue", "light": "brightBlue" },
    "markdownImageText": { "dark": "brightCyan", "light": "brightCyan" },
    "markdownCodeBlock": { "dark": "foreground", "light": "foreground" },
    "syntaxComment": { "dark": "brightBlack", "light": "brightBlack" },
    "syntaxKeyword": { "dark": "brightPurple", "light": "brightPurple" },
    "syntaxFunction": { "dark": "brightGreen", "light": "brightGreen" },
    "syntaxVariable": { "dark": "foreground", "light": "foreground" },
    "syntaxString": { "dark": "brightYellow", "light": "brightYellow" },
    "syntaxNumber": { "dark": "brightRed", "light": "brightRed" },
    "syntaxType": { "dark": "brightCyan", "light": "brightCyan" },
    "syntaxOperator": { "dark": "brightBlue", "light": "brightBlue" },
    "syntaxPunctuation": { "dark": "cyan", "light": "cyan" }
  }
}
