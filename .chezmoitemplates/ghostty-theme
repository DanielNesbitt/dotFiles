{{- /* Renders one entry of .terminal.themes as a Ghostty theme file. */ -}}
{{- $t := . -}}
# Generated by chezmoi from .chezmoidata/terminal-themes.yaml - do not edit.
{{ range $i, $k := list "black" "red" "green" "yellow" "blue" "purple" "cyan" "white" "brightBlack" "brightRed" "brightGreen" "brightYellow" "brightBlue" "brightPurple" "brightCyan" "brightWhite" -}}
palette = {{ $i }}={{ index $t $k }}
{{ end -}}
background = {{ $t.background }}
foreground = {{ $t.foreground }}
cursor-color = {{ $t.cursorColor }}
{{ with $t.cursorText }}cursor-text = {{ . }}
{{ end -}}
selection-background = {{ $t.selectionBackground }}
{{ with $t.selectionForeground }}selection-foreground = {{ . }}
{{ end -}}
